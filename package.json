{
  "name": "ftd-metrics-exporter",
  "version": "0.1.0",
  "description": "Prometheus exporter for Cisco FTD firewall health metrics (SCC/cdFMC and standalone on-prem FMC backends)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apilbeam101/ftd-metrics-exporter.git"
  },
  "homepage": "https://github.com/apilbeam101/ftd-metrics-exporter#readme",
  "bugs": {
    "url": "https://github.com/apilbeam101/ftd-metrics-exporter/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/",
    "example.env",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "ftd-metrics-exporter": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-strip-types --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --experimental-strip-types --expose-gc --test \"test/integration/**/*.test.ts\""
  },
  "dependencies": {
    "prom-client": "^15.1.3",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.1.2",
    "selfsigned": "^5.5.0",
    "typescript": "^7.0.2"
  }
}
