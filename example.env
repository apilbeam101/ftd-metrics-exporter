# ftd-metrics-exporter — example configuration
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# This file is the authoritative user-facing configuration reference —
# every variable, its purpose, and how to obtain it.
# Placeholders only. Never commit real credentials here or anywhere.

## --- Core ---

# Which management API to poll: "scc" or "fmc". Required, no default.
# Selects which of the two backend blocks below is used; set only one
# block's variables, or you'll get a startup warning that the wrong block
# was edited.
BACKEND_TYPE=

# TCP port for the /metrics listener.
METRICS_PORT=10049

# Interface to bind the /metrics listener to. 0.0.0.0 = all interfaces;
# 127.0.0.1 restricts to localhost (useful behind a reverse proxy on the
# same host). Do not expose /metrics to untrusted networks — there is no
# built-in authentication for it.
METRICS_BIND_ADDRESS=0.0.0.0

# Upstream poll cadence in seconds. This is NOT the Prometheus scrape
# interval — the exporter polls upstream on its own timer and always serves
# /metrics from an in-memory cache, so Prometheus can scrape as often as it
# likes without hitting SCC's rate limit.
#
# On BACKEND_TYPE=scc: minimum 30 (SCC's health/metrics endpoint has a hard
# 2 requests/minute limit). A lower value is a startup error, not a silent
# clamp.
# On BACKEND_TYPE=fmc: no 30s floor, but the constraint is aggregate
# request-budget across all devices x metric families — for fleets above
# roughly 40 devices, consider raising this instead.
POLL_INTERVAL_SECONDS=60

# Log verbosity: error | warn | info | debug.
LOG_LEVEL=info

# Log output format: json (recommended for production, one object per
# line) or text (human-readable, for local runs).
LOG_FORMAT=json

# Per-upstream-request total time budget, in seconds. No unbounded waits.
REQUEST_TIMEOUT_SECONDS=30

# Whether to also expose Node.js/process-level default metrics
# (process_cpu_seconds_total, nodejs_heap_size_bytes, etc.) from
# prom-client's collectDefaultMetrics, in addition to the ftd_* metrics.
# Defaults to true.
ENABLE_DEFAULT_METRICS=true

## --- SCC backend (required when BACKEND_TYPE=scc) ---

# Regional API base URL. Never defaulted — you must state your region
# explicitly. Treated as an opaque prefix: the adapter appends only the
# endpoint-relative path, so this works unchanged whether you use the
# current or legacy hostname form below.
#
# Current (recommended) regional base URLs:
#   US        https://api.us.security.cisco.com/firewall
#   EU        https://api.eu.security.cisco.com/firewall
#   APJ       https://api.apj.security.cisco.com/firewall
#   Australia https://api.au.security.cisco.com/firewall
#   India     https://api.in.security.cisco.com/firewall
#   UAE       https://api.uae.security.cisco.com/firewall
#   FedRAMP   https://manage.secure.cisco/api/rest  (excludes MSP APIs)
#
# Legacy (DEPRECATED but still functional) hostnames, of the form
# edge.<region>.cdo.cisco.com — e.g. https://edge.eu.cdo.cisco.com. These
# continue to work today but Cisco is migrating away from them; the
# exporter warns at startup if it detects one, and updating to the current
# form above is recommended.
#
# http:// URLs are rejected — HTTPS is mandatory for all upstream calls.
SCC_BASE_URL=

# Static, non-expiring bearer token.
#
# Obtain via: SCC UI -> Settings -> User Management -> "+" -> give the user
# a name -> check "API Only User" -> select Read-only (least privilege —
# the exporter only issues GETs; recommended over Edit-capable roles) ->
# OK -> Generate API Token.
#
# The token is shown exactly once — copy it immediately, it cannot be
# retrieved again later. Because these tokens never expire, nothing forces
# hygiene: it is recommended (not an API requirement) to rotate this
# periodically, e.g. every 90 days, aligned to your own credential policy.
SCC_API_TOKEN=

# UID of the cloud-delivered FMC (cdFMC) whose managed devices are polled.
# Obtain via the SCC inventory UI, or GET /v1/inventory/managers.
SCC_FMC_UID=

# Averaging window requested upstream for each health-metrics call.
# One of: 5m | 15m | 30m | 1h.
SCC_TIME_RANGE=5m

# Device-inventory poll cadence, independent of the health-metrics poll
# above — gives ftd_device_info/ftd_device_connectivity_up (an unreachable
# device is otherwise silently absent from health/metrics entirely). Shares
# the health-metrics request's spacing guard, so SCC's 2 requests/minute
# limit holds structurally regardless of this value; the default below is a
# freshness choice, not a rate-limit safety one.
SCC_INVENTORY_POLL_INTERVAL_SECONDS=300

## --- Standalone on-prem FMC backend (required when BACKEND_TYPE=fmc) ---

# FMC hostname or IP. A hostname is strongly preferred over an IP so that
# TLS certificate verification can succeed — FMC's default self-signed
# certificate's SAN typically names a hostname, and hostname verification
# stays active even when using FMC_CA_BUNDLE_PATH below.
FMC_HOST=

# API service-account username.
#
# MUST be a dedicated API-only account, not a human admin's own login.
# Cisco documents that a single FMC account cannot be used via the UI and
# the API simultaneously — doing so silently logs the other session out.
# If you reuse your own admin account here, you will intermittently and
# confusingly log yourself out of the FMC web UI, and the exporter will
# intermittently see 401s. Create a dedicated service account for this
# exporter.
FMC_USERNAME=

# Service-account password.
FMC_PASSWORD=

# Domain UUID to scope requests to. If unset, resolved automatically from
# the claims embedded in the access token returned by FMC's
# /auth/generatetoken (the Global domain, typically). Only set this
# explicitly if you want to scope the exporter to one FMC sub-domain.
FMC_DOMAIN_UUID=

# RECOMMENDED TLS path. Path to a PEM file containing FMC's certificate
# (if self-signed) or your internal CA chain (if FMC's certificate was
# issued by an internal PKI). FMC ships a self-signed certificate by
# default and provides no CA bundle mechanism of its own — this is the
# operator-supplied trust anchor for FMC connections *only* (not a
# system-wide trust change). Full certificate and hostname verification
# remain active; only the trust root changes.
#
# To obtain the certificate:
#   openssl s_client -connect <fmc-host>:443 -showcerts
# Verify the fingerprint out-of-band against the FMC UI before trusting it
# — otherwise you are trusting whatever answered the connection, which is
# exactly the attack this bundle is meant to prevent.
#
# Windows paths are supported, e.g. C:\certs\fmc-ca.pem
FMC_CA_BUNDLE_PATH=

# INSECURE — lab/test only. Never set true in production.
# Disables certificate verification for FMC requests entirely. When true,
# a loud multi-line warning is logged at error severity on every startup,
# and ftd_exporter_tls_verification_disabled is set to 1 so this is
# visible (and alertable) in your monitoring system, not just a log line
# that scrolls away. FMC credentials and all metrics data become exposed
# to undetectable interception. Prefer FMC_CA_BUNDLE_PATH above.
#
# Setting this to true together with FMC_CA_BUNDLE_PATH is a startup ERROR
# — that combination means you believe you have configured trust while
# verification is actually off, which is the most dangerous possible
# misconfiguration.
#
# This escape hatch only exists for the FMC backend. SCC always uses
# publicly CA-issued certificates and verification cannot be disabled for
# it.
FMC_TLS_INSECURE_SKIP_VERIFY=false

# Concurrency cap for per-device requests, 1-10 inclusive. Validated
# against FMC's documented 10-connection-per-source-IP limit. The default
# of 5 (rather than the 10 ceiling) leaves headroom for other API
# consumers you may have that the exporter cannot see.
FMC_MAX_CONCURRENT_REQUESTS=5

# Device-inventory refresh cadence in seconds, independent of the metric
# poll interval above. Device inventory changes on a timescale of days, so
# this defaults to a much slower cadence (15 minutes) than the metric
# poll.
FMC_DISCOVERY_INTERVAL_SECONDS=900

# Comma-separated subset of: CPU,MEM,INTERFACE,DISK_STATS,CHASSIS_STATS.
# Reduces per-cycle request volume on large fleets — FMC has no batched
# equivalent to SCC's single call, so each family is one request per
# device per poll cycle. Drop CHASSIS_STATS entirely on all-appliance
# fleets where it returns nothing useful. Defaults to all five.
FMC_METRIC_FAMILIES=CPU,MEM,INTERFACE,DISK_STATS,CHASSIS_STATS

# Averaging window, same vocabulary as SCC_TIME_RANGE above:
# 5m | 15m | 30m | 1h.
FMC_TIME_RANGE=5m

## --- Exporter TLS listener (optional) ---
## For most Kubernetes/Alloy deployments, terminating TLS at a reverse
## proxy or service mesh (and leaving these unset) is recommended. Native
## TLS is provided for standalone/VM deployments with no proxy in front.

# PEM certificate (chain) for the /metrics HTTPS listener. Setting this
# together with METRICS_TLS_KEY_PATH enables TLS on the listener; leaving
# both unset serves plain HTTP. Must be set together with the key or not
# at all — one without the other is a startup error.
METRICS_TLS_CERT_PATH=

# PEM private key for the certificate above. Should be readable only by
# the service account running the exporter.
METRICS_TLS_KEY_PATH=

# Minimum TLS version offered by the /metrics listener: TLSv1.2 or
# TLSv1.3 only — earlier versions are never offered.
METRICS_TLS_MIN_VERSION=TLSv1.2

# Enables mutual TLS: only scrape clients presenting a certificate signed
# by this CA are accepted. The strongest available access control for the
# /metrics endpoint; straightforward for Prometheus/Alloy to configure
# client-side.
METRICS_TLS_CLIENT_CA_PATH=
